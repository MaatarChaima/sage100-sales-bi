                  <xs:element name="DDT_Annee" msprop:design-time-name="35b04372-e610-452d-a89e-476fcc161d24" msprop:DbColumnName="DDT_Annee" msprop:FriendlyName="DDT_Annee" type="xs:int" minOccurs="0" />
                  <xs:element name="DDT_NumMois" msprop:design-time-name="30745556-abf8-48e0-9f00-b4510d32631f" msprop:DbColumnName="DDT_NumMois" msprop:FriendlyName="DDT_NumMois" type="xs:int" minOccurs="0" />
                  <xs:element name="DDT_NomMois" msprop:design-time-name="8a6e5a5c-f3aa-44c1-8f9e-c2f163a7388d" msprop:DbColumnName="DDT_NomMois" msprop:FriendlyName="DDT_NomMois" minOccurs="0">
