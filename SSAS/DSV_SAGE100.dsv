            <xs:element name="dbo_DDT_Dim_Date" msprop:design-time-name="1b10ef44-3a3f-439e-adc1-b85448bcd642" msprop:IsLogical="True" msprop:FriendlyName="DDT_Dim_Date" msprop:DbTableName="DDT_Dim_Date" msprop:TableType="View" msprop:QueryDefinition="SELECT DDT_IdDate, DDT_Date, DDT_Annee, DDT_NumMois, &#xD;&#xA;                  CASE WHEN DDT_NomMois = 'January' THEN 'Janvier' WHEN DDT_NomMois = 'February' THEN 'Février' WHEN DDT_NomMois = 'March' THEN 'Mars' WHEN DDT_NomMois = 'April' THEN 'Avril' WHEN DDT_NomMois = 'May' THEN 'Mai' WHEN&#xD;&#xA;                   DDT_NomMois = 'June' THEN 'Juin' WHEN DDT_NomMois = 'July' THEN 'Juillet' WHEN DDT_NomMois = 'August' THEN 'Août' WHEN DDT_NomMois = 'September' THEN 'Septembre' WHEN DDT_NomMois = 'October' THEN 'Octobre' WHEN DDT_NomMois&#xD;&#xA;                   = 'November' THEN 'Novembre' WHEN DDT_NomMois = 'December' THEN 'Décembre' ELSE 'Mois Inconnu' END AS DDT_NomMois, DDT_NumJourMois, DDT_NumTrimestre, DDT_NomTrimestre, DDT_NumSemestre, &#xD;&#xA;                  DDT_NomSemestre&#xD;&#xA;FROM     DDT_Dim_Date" msprop:QueryBuilder="SpecificQueryBuilder">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="DDT_IdDate" msprop:design-time-name="b454e516-f312-4e7d-b86c-3c7d19bf1027" msprop:DbColumnName="DDT_IdDate" msprop:FriendlyName="DDT_IdDate" type="xs:int" minOccurs="0" />
